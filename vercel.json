{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    {
      "source": "/",
      "destination": "/d",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|favicon|manifest|robots|site\\.webmanifest|sw\\.js|workbox).*)",
      "destination": "/api/server"
    }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 10,
      "includeFiles": "dist/server/**"
    }
  }
}
