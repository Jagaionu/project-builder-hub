# ============================================================
# The Prime Route - environment variables for Vercel.
# Vercel - Settings - Environment Variables - or Import .env. Replace every
# <...> placeholder with the real value and tick the Production environment
# (and Preview if you want preview deploys to work). Never commit real secrets.
# After changing any variable you MUST redeploy for it to take effect.
# ============================================================

# ---- Supabase (server-side) ----
SUPABASE_URL=<https://YOUR-PROJECT.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<service-role secret - server only, never expose>
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... - also used as the cron apikey>
SUPABASE_ANON_KEY=<eyJ... legacy anon (optional, cron apikey fallback)>

# ---- Supabase (client / build-time; MUST be VITE_ prefixed) ----
VITE_SUPABASE_URL=<https://YOUR-PROJECT.supabase.co>
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... (browser-safe)>

# ---- App ----
APP_BASE_URL=https://theprimeroute.co.uk

# ---- Stripe (payments) ----
STRIPE_SECRET_KEY=<sk_live_... for real payments, or sk_test_... while testing>
STRIPE_WEBHOOK_SECRET=<whsec_... from your Stripe webhook endpoint>

# ---- GoCardless (optional Direct Debit; leave blank if unused) ----
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=sandbox

# ---- Companies House (signup verification) ----
COMPANIES_HOUSE_API_KEY=<free key from developer.company-information.service.gov.uk>

# ---- Email (Resend for support alerts; transactional email is also configurable in-app) ----
RESEND_API_KEY=<re_...>
SUPPORT_ALERT_EMAIL=<inbox for support notifications>
SUPPORT_FROM_EMAIL=PrimeRoute Support <support@theprimeroute.co.uk>

# ---- Web Push (driver notifications) ----
VAPID_PUBLIC_KEY=<vapid public key>
VAPID_PRIVATE_KEY=<vapid private key>
VAPID_SUBJECT=mailto:admin@theprimeroute.co.uk
VITE_VAPID_PUBLIC_KEY=<same value as VAPID_PUBLIC_KEY, exposed to the client>

# ---- AI assistant (optional) ----
OPENAI_API_KEY=<sk-... optional; enables the AI assistant + knowledge base>

# ---- Encryption (admin credential cipher) ----
CREDENTIAL_ENC_KEY=<32-byte random secret (e.g. openssl rand -base64 32)>

# ---- Signup extras (client) ----
VITE_ONBOARDING_URL=<https://cal.com/... onboarding booking link (optional)>
VITE_CONTACT_EMAIL=hello@theprimeroute.co.uk

# ---- Build flags (leave unset unless building the driver-only PWA) ----
# VITE_DRIVER_APP=true
# VITE_USE_NATIVE_GPS_TRACKER=true
