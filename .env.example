# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real keys. The service-role key is a secret and bypasses RLS.

# --- Public (safe to expose in the browser) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Mirrors of the above used by server-side / scripts
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- SECRET (server/scripts only — NEVER ship to the client, NEVER commit) ---
# Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — server/scripts only. Do NOT prefix with VITE_ (that would expose it in the browser bundle).
# Create at https://platform.openai.com/api-keys — set usage limits on the key.
OPENAI_API_KEY=sk-your-openai-key

# Optional: used by `npm run setup:super-admin` (or pass via --email / --password)
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=change-me

# --- Billing / payments (server only — NEVER prefix with VITE_) ---
# Public base URL of the app, used to build dunning / billing links.
APP_BASE_URL=https://app.yourcompany.com

# Stripe (test-mode keys for development). Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Dashboard > Developers > Webhooks > signing secret for the endpoint
#   POST {APP_BASE_URL}/api/public/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# GoCardless (use the sandbox while developing).
GOCARDLESS_ACCESS_TOKEN=your-gocardless-access-token
GOCARDLESS_ENVIRONMENT=sandbox
# Webhook secret for the endpoint
#   POST {APP_BASE_URL}/api/public/webhooks/gocardless
GOCARDLESS_WEBHOOK_SECRET=your-gocardless-webhook-secret
